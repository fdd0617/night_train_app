# ============================================================
# 把这个文件复制为 .env 后填写自己的 key
#   cp .env.example .env
# .env 已被 .gitignore 排除，绝不会上传到 GitHub
# ============================================================

# ---------- 服务运行 ----------
PORT=5000

# ---------- 12306 ----------
RAIL_TIMEOUT=10
STATION_CACHE_PATH=station_names.json

# ---------- 夜间 / 早晨时段定义（24h）----------
NIGHT_START_HOUR=21
NIGHT_END_HOUR=8
MORNING_START_HOUR=6
MORNING_END_HOUR=10

# ---------- 目的地攻略（OpenAI 兼容接口）----------
# 留空则不启用攻略卡片，行程查询不受影响
OPENAI_API_KEY=YOUR_API_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 攻略缓存秒数（默认 7 天）
DEST_CACHE_TTL=604800
# LLM 单次请求超时秒数
DEST_TIMEOUT=30

# ---------- 接 DeepSeek 的示例（取消注释并替换上面三行）----------
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
